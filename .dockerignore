# Build context for the Dockerfile: only package*.json, tsconfig.json,
# scripts/, ui/ and src/ are needed. Everything else stays out.

# dependencies and build output (rebuilt inside the image)
node_modules
**/node_modules
dist

# VCS / editor / OS / agent files
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.claude
.DS_Store
*.swp

# tests and test artifacts
test
tests
coverage
.nyc_output
test-results
playwright-report
blob-report
playwright/.cache
*.log
*.tsbuildinfo

# docs and side projects
docs
*.md
openwebui

# container files themselves
Dockerfile
.dockerignore
compose.yaml
compose.*.yaml
docker-compose*.yml

# secrets / local env
.env
.env.*
*.pem
*.key
